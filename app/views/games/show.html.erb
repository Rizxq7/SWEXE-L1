<div class="container">
  <h1>ゲーム詳細</h1>

  <div class="card">
    <div class="detail-row">
      <span class="detail-label">タイトル</span>
      <span><%= @game.title %></span>
    </div>

    <div class="detail-row">
      <span class="detail-label">ジャンル</span>
      <span><%= @game.genre %></span>
    </div>

    <div class="detail-row">
      <span class="detail-label">評価</span>
      <span class="rating">
        <%= "★" * @game.rating %>
        <%= @game.rating %> / 5
      </span>
    </div>
  </div>

  <div class="detail-actions">
    <%= link_to "編集", edit_game_path(@game), class: "btn btn-edit" %>

    <%= button_to "削除",
          game_path(@game),
          method: :delete,
          class: "btn btn-delete",
          form: { class: "delete-form" },
          data: { turbo_confirm: "本当に削除しますか？" } %>

    <%= link_to "一覧に戻る", games_path, class: "btn btn-back" %>
  </div>
</div>