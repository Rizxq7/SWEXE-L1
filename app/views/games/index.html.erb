<div class="container">
  <div class="page-header">
    <h1>ゲーム一覧</h1>
    <%= link_to "＋ ゲームを登録", new_game_path, class: "btn btn-primary" %>
  </div>

  <% if @games.any? %>
    <table>
      <thead>
        <tr>
          <th>タイトル</th>
          <th>ジャンル</th>
          <th>評価</th>
          <th>操作</th>
        </tr>
      </thead>

      <tbody>
        <% @games.each do |game| %>
          <tr>
            <td><%= game.title %></td>
            <td><%= game.genre %></td>
            <td class="rating">
              <%= "★" * game.rating %>
              <span><%= game.rating %> / 5</span>
            </td>
            <td class="actions">
              <%= link_to "詳細", game_path(game), class: "btn btn-show" %>
              <%= link_to "編集", edit_game_path(game), class: "btn btn-edit" %>

              <%= button_to "削除",
                    game_path(game),
                    method: :delete,
                    class: "btn btn-delete",
                    form: { class: "delete-form" },
                    data: { turbo_confirm: "本当に削除しますか？" } %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <div class="empty-message">
      登録されているゲームはありません。
    </div>
  <% end %>
</div>