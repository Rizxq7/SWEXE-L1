<h1>ゲーム編集</h1>

<%= form_with model: @game do |form| %>

  <p>
    <%= form.label :title, "タイトル" %><br>
    <%= form.text_field :title %>
  </p>

  <p>
    <%= form.label :genre, "ジャンル" %><br>
    <%= form.text_field :genre %>
  </p>

  <p>
    <%= form.label :rating, "評価" %><br>
    <%= form.select :rating, 1..5 %>
  </p>

  <p>
    <%= form.submit "更新" %>
  </p>

<% end %>

<%= link_to "一覧に戻る", games_path %>